    <style>
        :root {
            --jhc-blue: #005696;
            --jhc-yellow: #FEDD00;
            --jhc-red: #E1251B;
            --jhc-bg: #FFFFFF;
        }

        body {
            font-family: 'Noto Sans TC', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 16px;
            background-color: var(--jhc-bg);
            color: #333;
            -webkit-font-smoothing: antialiased;
        }

        /* 响应式字体大小 */
        @media (min-width: 768px) {
            body {
                font-size: 17px;
            }
        }

        @media (min-width: 1024px) {
            body {
                font-size: 18px;
            }
        }

        .jhc-blue {
            background-color: var(--jhc-blue);
        }

        .jhc-text-blue {
            color: var(--jhc-blue);
        }

        .jhc-yellow {
            background-color: var(--jhc-yellow);
        }

        .jhc-text-red {
            color: var(--jhc-red);
        }

        .jhc-border-blue {
            border-color: var(--jhc-blue);
        }

        .jhc-border-yellow {
            border-color: var(--jhc-yellow);
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .promo-stripe {
            background: repeating-linear-gradient(45deg,
                    var(--jhc-yellow),
                    var(--jhc-yellow) 10px,
                    #fcd100 10px,
                    #fcd100 20px);
        }

        .retail-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        @media (min-width: 640px) {
            .retail-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (min-width: 768px) {
            .retail-grid {
                grid-template-columns: repeat(4, 1fr);
                gap: 12px;
            }
        }

        @media (min-width: 1024px) {
            .retail-grid {
                grid-template-columns: repeat(6, 1fr);
            }
        }
    </style>

